# Configure the embedded Google map, then create a NEW native build.
# Configure restricted keys in .env.local or the EAS build environment.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
# Web map: Maps Embed API key restricted to your website origins (public by design).
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
# API host reachable by the mobile phone; HTTPS required for release APKs.
EXPO_PUBLIC_MAPS_API_URL=
# SERVER ONLY: Places API (New) + Routes API. Never use an EXPO_PUBLIC_ prefix.
GOOGLE_MAPS_SERVER_API_KEY=
