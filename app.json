{
  "expo": {
    "name": "robia-IoT",
    "slug": "robia-IoT",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/robia-iot-logo-v1.png",
    "scheme": "robiaiot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/robia-iot-logo-v1.png"
    },
    "android": {
      "package": "com.robia.mobile",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/robia-iot-logo-v1.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager creates this Room database through reflection at process startup.\n# Keep its no-argument constructor in R8 full mode.\n-keep class androidx.work.impl.WorkDatabase_Impl { public <init>(); }"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/robia-iot-logo-v1.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-sharing",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "36f28f99-394e-42e6-bd79-a3016b0f36ce"
      }
    }
  }
}
